{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": [
      "node",
      "mocha"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "ts-node": {
    "esm": true,
    "transpileOnly": true,
    "experimentalSpecifierResolution": "node"
  },
  "include": [
    "entities/**/*.d.ts",
    "entities/**/*.ts",
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
